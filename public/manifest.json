{
  "manifest_version": 3,
  "name": "MindfulBrowsing",
  "version": "1.2.0",
  "description": "A Chrome extension that helps create mental barriers before accessing potentially distracting websites with robust subdomain support and enhanced features",
  "permissions": ["tabs", "storage", "activeTab", "scripting", "background"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MindfulBrowsing Settings"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "icons/*.png",
        "onboarding.html",
        "intention-check.html",
        "mindful-pause.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
